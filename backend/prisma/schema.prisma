generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ──────────────────────────────────────────────
// ENUMS
// ──────────────────────────────────────────────

enum Role {
  ADMIN
  CASHIER
  KITCHEN1
  KITCHEN2
  WAITER
}

enum OrderType {
  DINE_IN
  DELIVERY
}

enum OrderStatus {
  NEW
  PREPARING
  READY
  COLLECTED
  DELIVERED
  CANCELLED
}

enum KitchenStatus {
  NEW
  PREPARING
  READY
}

enum Kitchen {
  KITCHEN_1
  KITCHEN_2
}

enum PaymentMethod {
  CASH
  ONLINE
  CREDIT
}

enum PaymentStatus {
  PENDING
  COMPLETED
  FAILED
  REFUNDED
}

enum TableStatus {
  AVAILABLE
  OCCUPIED
  RESERVED
}

enum CreditType {
  DEBIT
  CREDIT
}

enum StaffStatus {
  ACTIVE
  INACTIVE
}

enum DeliveryStatus {
  PENDING
  HANDED_TO_DELIVERY
  DELIVERED
}

// ──────────────────────────────────────────────
// USER & AUTH
// ──────────────────────────────────────────────

model User {
  id            String   @id @default(uuid())
  username      String   @unique
  passwordHash  String   @map("password_hash")
  displayName   String   @map("display_name")
  role          Role
  isActive      Boolean  @default(true) @map("is_active")
  refreshToken  String?  @map("refresh_token")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  // Relations
  orders        Order[]       @relation("CreatedByUser")
  payments      Payment[]     @relation("RecordedByUser")
  expenses      Expense[]     @relation("CreatedByUser")
  auditLogs     AuditLog[]

  @@map("users")
}

// ──────────────────────────────────────────────
// MENU & CATEGORIES
// ──────────────────────────────────────────────

model Category {
  id        String   @id @default(uuid())
  name      String   @unique
  sortOrder Int      @default(0) @map("sort_order")
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  // Relations
  menuItems MenuItem[]

  @@map("categories")
}

model MenuItem {
  id          String   @id @default(uuid())
  name        String
  price       Decimal  @db.Decimal(10, 2)
  description String?
  kitchen     Kitchen
  categoryId  String   @map("category_id")
  isAvailable Boolean  @default(true) @map("is_available")
  sortOrder   Int      @default(0) @map("sort_order")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  // Relations
  category   Category    @relation(fields: [categoryId], references: [id])
  orderItems OrderItem[]

  @@index([categoryId])
  @@index([kitchen])
  @@map("menu_items")
}

// ──────────────────────────────────────────────
// TABLES
// ──────────────────────────────────────────────

model Table {
  id       String      @id @default(uuid())
  number   Int         @unique
  capacity Int         @default(4)
  status   TableStatus @default(AVAILABLE)

  // Relations
  orders Order[]

  @@map("tables")
}

// ──────────────────────────────────────────────
// CUSTOMERS
// ──────────────────────────────────────────────

model Customer {
  id              String   @id @default(uuid())
  name            String
  mobile          String?  @unique
  address         String?
  customerType    String?  @map("customer_type")
  creditBalance   Decimal  @default(0) @map("credit_balance") @db.Decimal(12, 2)
  isActive        Boolean  @default(true) @map("is_active")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  // Relations
  orders          Order[]
  creditLedger    CreditLedger[]
  deliveryOrders  DeliveryInfo[]

  @@index([mobile])
  @@index([name])
  @@map("customers")
}

// ──────────────────────────────────────────────
// CREDIT LEDGER
// ──────────────────────────────────────────────

model CreditLedger {
  id           String     @id @default(uuid())
  customerId   String     @map("customer_id")
  orderId      String?    @map("order_id")
  type         CreditType
  amount       Decimal    @db.Decimal(12, 2)
  balanceAfter Decimal    @map("balance_after") @db.Decimal(12, 2)
  description  String
  createdAt    DateTime   @default(now()) @map("created_at")

  // Relations
  customer Customer @relation(fields: [customerId], references: [id])
  order    Order?   @relation(fields: [orderId], references: [id])

  @@index([customerId])
  @@index([createdAt])
  @@map("credit_ledger")
}

// ──────────────────────────────────────────────
// ORDERS
// ──────────────────────────────────────────────

model Order {
  id          String      @id @default(uuid())
  orderNumber Int         @unique @default(autoincrement()) @map("order_number")
  type        OrderType
  status      OrderStatus @default(NEW)
  tableId     String?     @map("table_id")
  customerId  String?     @map("customer_id")
  subtotal    Decimal     @default(0) @db.Decimal(12, 2)
  total       Decimal     @default(0) @db.Decimal(12, 2)
  notes       String?
  createdBy   String      @map("created_by")
  createdAt   DateTime    @default(now()) @map("created_at")
  updatedAt   DateTime    @updatedAt @map("updated_at")

  // Relations
  table         Table?         @relation(fields: [tableId], references: [id])
  customer      Customer?      @relation(fields: [customerId], references: [id])
  createdByUser User           @relation("CreatedByUser", fields: [createdBy], references: [id])
  orderItems    OrderItem[]
  kitchenOrders KitchenOrder[]
  payment       Payment?
  deliveryInfo  DeliveryInfo?
  creditLedger  CreditLedger[]

  @@index([orderNumber])
  @@index([status])
  @@index([createdAt])
  @@index([createdBy])
  @@map("orders")
}

model OrderItem {
  id            String        @id @default(uuid())
  orderId       String        @map("order_id")
  menuItemId    String        @map("menu_item_id")
  quantity      Int
  unitPrice     Decimal       @map("unit_price") @db.Decimal(10, 2)
  totalPrice    Decimal       @map("total_price") @db.Decimal(10, 2)
  kitchen       Kitchen
  kitchenStatus KitchenStatus @default(NEW) @map("kitchen_status")
  notes         String?
  createdAt     DateTime      @default(now()) @map("created_at")

  // Relations
  order    Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  menuItem MenuItem @relation(fields: [menuItemId], references: [id])

  @@index([orderId])
  @@index([kitchen])
  @@map("order_items")
}

model KitchenOrder {
  id        String        @id @default(uuid())
  orderId   String        @map("order_id")
  kitchen   Kitchen
  status    KitchenStatus @default(NEW)
  createdAt DateTime      @default(now()) @map("created_at")
  updatedAt DateTime      @updatedAt @map("updated_at")

  // Relations
  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@unique([orderId, kitchen])
  @@index([kitchen, status])
  @@map("kitchen_orders")
}

// ──────────────────────────────────────────────
// PAYMENTS
// ──────────────────────────────────────────────

model Payment {
  id            String        @id @default(uuid())
  orderId       String        @unique @map("order_id")
  amount        Decimal       @db.Decimal(12, 2)
  method        PaymentMethod
  status        PaymentStatus @default(PENDING)
  transactionId String?       @map("transaction_id")
  recordedBy    String        @map("recorded_by")
  createdAt     DateTime      @default(now()) @map("created_at")
  updatedAt     DateTime      @updatedAt @map("updated_at")

  // Relations
  order          Order @relation(fields: [orderId], references: [id])
  recordedByUser User  @relation("RecordedByUser", fields: [recordedBy], references: [id])

  @@index([method])
  @@index([createdAt])
  @@map("payments")
}

// ──────────────────────────────────────────────
// DELIVERY
// ──────────────────────────────────────────────

model DeliveryInfo {
  id           String         @id @default(uuid())
  orderId      String         @unique @map("order_id")
  customerId   String         @map("customer_id")
  address      String
  deliveryBoy  String?        @map("delivery_boy")
  phone        String?
  status       DeliveryStatus @default(PENDING)
  notes        String?
  createdAt    DateTime       @default(now()) @map("created_at")
  updatedAt    DateTime       @updatedAt @map("updated_at")

  // Relations
  order    Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  customer Customer @relation(fields: [customerId], references: [id])

  @@map("delivery_info")
}

// ──────────────────────────────────────────────
// EXPENSES
// ──────────────────────────────────────────────

model ExpenseCategory {
  id        String   @id @default(uuid())
  name      String   @unique
  createdAt DateTime @default(now()) @map("created_at")

  // Relations
  expenses Expense[]

  @@map("expense_categories")
}

model Expense {
  id            String        @id @default(uuid())
  categoryId    String        @map("category_id")
  description   String
  amount        Decimal       @db.Decimal(12, 2)
  date          DateTime      @db.Date
  paymentMethod PaymentMethod @map("payment_method")
  createdBy     String        @map("created_by")
  createdAt     DateTime      @default(now()) @map("created_at")
  updatedAt     DateTime      @updatedAt @map("updated_at")

  // Relations
  category      ExpenseCategory @relation(fields: [categoryId], references: [id])
  createdByUser User            @relation("CreatedByUser", fields: [createdBy], references: [id])

  @@index([date])
  @@index([categoryId])
  @@map("expenses")
}

// ──────────────────────────────────────────────
// STAFF & SALARY
// ──────────────────────────────────────────────

model Staff {
  id          String      @id @default(uuid())
  name        String
  role        String
  contact     String?
  salary      Decimal     @db.Decimal(10, 2)
  joiningDate DateTime    @map("joining_date") @db.Date
  status      StaffStatus @default(ACTIVE)
  createdAt   DateTime    @default(now()) @map("created_at")
  updatedAt   DateTime    @updatedAt @map("updated_at")

  // Relations
  salaryPayments SalaryPayment[]

  @@map("staff")
}

model SalaryPayment {
  id            String        @id @default(uuid())
  staffId       String        @map("staff_id")
  amount        Decimal       @db.Decimal(10, 2)
  month         Int
  year          Int
  paymentDate   DateTime      @map("payment_date") @db.Date
  paymentMethod PaymentMethod @map("payment_method")
  notes         String?
  createdAt     DateTime      @default(now()) @map("created_at")

  // Relations
  staff Staff @relation(fields: [staffId], references: [id])

  @@unique([staffId, month, year])
  @@map("salary_payments")
}

// ──────────────────────────────────────────────
// AUDIT LOG
// ──────────────────────────────────────────────

model AuditLog {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  action    String
  entity    String
  entityId  String?  @map("entity_id")
  details   Json?
  ipAddress String?  @map("ip_address")
  createdAt DateTime @default(now()) @map("created_at")

  // Relations
  user User @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([entity, entityId])
  @@index([createdAt])
  @@map("audit_logs")
}
